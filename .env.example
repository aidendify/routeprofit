PORT=8080
DATABASE_PATH=/data/routeprofit.db
UPLOAD_DIR=/data/uploads
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=

# Leakage rates (UI /settings can override into SQLite)
HOURLY_RATE_DOLLARS=125
DEADHEAD_COST_PER_MILE=0.80
GAP_THRESHOLD_MINUTES=30

# Optional weekly summary email. Leave SMTP_HOST unset to skip.
OWNER_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# FROM_NAME=
# FROM_EMAIL=

# Optional footer link labeled "Powered by RouteProfit". Leave empty for no footer.
MARKETING_URL=
